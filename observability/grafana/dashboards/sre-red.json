{
 "title": "payment-api — SRE (RED)",
 "uid": "payment-sre-red",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Rate — requêtes/s",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(http_requests_total{app=\"payment-api\",path!~\"/metrics|/health\"}[$__rate_interval]))",
     "legendFormat": "RPS",
     "refId": "A"
    },
    {
     "expr": "sum by (path) (rate(http_requests_total{app=\"payment-api\",path!~\"/metrics|/health\"}[$__rate_interval]))",
     "legendFormat": "{{path}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Errors — erreurs/s (5xx)",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(http_requests_total{app=\"payment-api\",path!~\"/metrics|/health\",status=~\"5..\"}[$__rate_interval]))",
     "legendFormat": "5xx/s",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Errors — % global",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "100 * sum(rate(http_requests_total{app=\"payment-api\",path!~\"/metrics|/health\",status=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{app=\"payment-api\",path!~\"/metrics|/health\"}[$__rate_interval]))",
     "legendFormat": "% erreurs",
     "refId": "A"
    },
    {
     "expr": "100 * 0.005",
     "legendFormat": "seuil SLO (0.5 %)",
     "refId": "B"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Duration — latences",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"payment-api\",path!~\"/metrics|/health\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.9, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"payment-api\",path!~\"/metrics|/health\"}[$__rate_interval])))",
     "legendFormat": "p90",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"payment-api\",path!~\"/metrics|/health\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "C"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"payment-api\",path!~\"/metrics|/health\"}[$__rate_interval])))",
     "legendFormat": "p99",
     "refId": "D"
    }
   ]
  },
  {
   "id": 5,
   "type": "gauge",
   "title": "Error Budget restant (30 j)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "slo:error_budget_remaining:ratio",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Burn rate (1 h / 6 h) vs seuils 14.4 et 6",
   "gridPos": {
    "x": 18,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sli:error_ratio:rate1h / 0.005",
     "legendFormat": "burn 1h",
     "refId": "A"
    },
    {
     "expr": "sli:error_ratio:rate6h / 0.005",
     "legendFormat": "burn 6h",
     "refId": "B"
    },
    {
     "expr": "vector(14.4)",
     "legendFormat": "seuil critical",
     "refId": "C"
    },
    {
     "expr": "vector(6)",
     "legendFormat": "seuil warning",
     "refId": "D"
    }
   ]
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Logs corrélés (Loki) — cliquer trace_id -> Tempo",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{app=\"payment-api\"} | json | level=\"ERROR\"",
     "refId": "A"
    }
   ]
  }
 ]
}